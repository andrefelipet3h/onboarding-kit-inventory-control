@model List<ConsumoProduto>
<div class="tabela-rolavel">
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>Produto</th>
                <th>Categoria</th>
                <th>Departamento</th>
                <th class="text-end">Kits</th>
                <th class="text-end">Unidades</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in Model)
            {
                <tr>
                    <td>@c.NomeProduto</td>
                    <td>@c.Categoria</td>
                    <td>@c.NomeDepartamento</td>
                    <td class="text-end">@c.QtdKits</td>
                    <td class="text-end"><strong>@c.QtdUnidades</strong></td>
                </tr>
            }
            @if (Model.Count == 0)
            {
                <tr><td colspan="5" class="vazio">Nenhum produto encontrado com esses filtros.</td></tr>
            }
        </tbody>
    </table>
</div>
@if (Model.Count > 0)
{
    <p class="dica px-3 pt-2">Total: @Model.Sum(c => c.QtdUnidades) unidade(s) usadas nos kits.</p>
}
