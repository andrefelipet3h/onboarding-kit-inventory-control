@model Departamento
@{
    ViewData["Title"] = "Cadastro de departamento";
}
<div class="page-head"><h1>Cadastro de departamento</h1></div>

<div class="cartao" style="max-width: 640px;">
    <div class="cartao-corpo">
        <form asp-action="Save" method="post" novalidate>
            <input type="hidden" name="Operacao" value="@ViewBag.Operacao" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="mb-3" style="max-width: 160px;">
                <label asp-for="Id" class="form-label">Código</label>
                <input asp-for="Id" class="form-control" readonly="@(ViewBag.Operacao == "A")" />
                <span asp-validation-for="Id" class="erro-campo"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Nome" class="form-label"></label>
                <input asp-for="Nome" class="form-control" maxlength="60" />
                <span asp-validation-for="Nome" class="erro-campo"></span>
            </div>
            <div class="mb-4" style="max-width: 240px;">
                <label asp-for="CentroCusto" class="form-label"></label>
                <input asp-for="CentroCusto" class="form-control" maxlength="20" placeholder="Ex.: CC-100" />
                <span asp-validation-for="CentroCusto" class="erro-campo"></span>
            </div>

            <button type="submit" class="btn btn-primary">Salvar</button>
            <a class="btn btn-link" asp-action="Index">Voltar</a>
        </form>
    </div>
</div>
