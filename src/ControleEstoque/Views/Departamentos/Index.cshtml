@model List<Departamento>
@{
    ViewData["Title"] = "Departamentos";
}
<div class="page-head">
    <h1>Departamentos</h1>
    <a class="btn btn-primary" asp-action="Create">Novo departamento</a>
</div>

<div class="cartao">
    <div class="tabela-rolavel">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Código</th>
                    <th>Nome</th>
                    <th>Centro de custo</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in Model)
                {
                    <tr>
                        <td><strong>@d.Id</strong></td>
                        <td>@d.Nome</td>
                        <td>@d.CentroCusto</td>
                        <td class="acoes-linha">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@d.Id" title="Editar"><i class="bi bi-pencil"></i></a>
                            <partial name="_BotaoExcluir" model="d.Id" />
                        </td>
                    </tr>
                }
                @if (Model.Count == 0)
                {
                    <tr><td colspan="4" class="vazio">Nenhum departamento cadastrado.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
