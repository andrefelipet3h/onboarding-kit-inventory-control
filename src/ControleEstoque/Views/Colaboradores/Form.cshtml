@model Colaborador
@{
    ViewData["Title"] = "Cadastro de colaborador";
}
<div class="page-head"><h1>Cadastro de colaborador</h1></div>

<div class="cartao" style="max-width: 860px;">
    <div class="cartao-corpo">
        <form asp-action="Save" method="post" enctype="multipart/form-data" novalidate>
            <input type="hidden" name="Operacao" value="@ViewBag.Operacao" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="row g-3 mb-3">
                <div class="col-sm-2">
                    <label asp-for="Id" class="form-label">Código</label>
                    <input asp-for="Id" class="form-control" readonly="@(ViewBag.Operacao == "A")" />
                    <span asp-validation-for="Id" class="erro-campo"></span>
                </div>
                <div class="col-sm-7">
                    <label asp-for="Nome" class="form-label"></label>
                    <input asp-for="Nome" class="form-control" maxlength="80" />
                    <span asp-validation-for="Nome" class="erro-campo"></span>
                </div>
                <div class="col-sm-3">
                    <label asp-for="Funcional" class="form-label"></label>
                    <input asp-for="Funcional" class="form-control" maxlength="7" inputmode="numeric" placeholder="0000000" />
                    <span asp-validation-for="Funcional" class="erro-campo"></span>
                </div>
                <div class="col-sm-6">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" maxlength="80" />
                    <span asp-validation-for="Email" class="erro-campo"></span>
                </div>
                <div class="col-sm-6">
                    <label asp-for="DepartamentoId" class="form-label"></label>
                    <select asp-for="DepartamentoId" asp-items="ViewBag.Departamentos" class="form-select"></select>
                    <span asp-validation-for="DepartamentoId" class="erro-campo"></span>
                </div>
                <div class="col-sm-4">
                    <label asp-for="DataAdmissao" class="form-label"></label>
                    <input type="date" name="DataAdmissao" value="@Model.DataAdmissao.ToString("yyyy-MM-dd")" class="form-control" />
                    <span asp-validation-for="DataAdmissao" class="erro-campo"></span>
                </div>
                <div class="col-sm-8">
                    <label asp-for="Senha" class="form-label">Senha de acesso à área do colaborador</label>
                    <input asp-for="Senha" class="form-control" autocomplete="new-password"
                           placeholder="@(ViewBag.Operacao == "A" ? "Deixe em branco para manter a senha atual" : "Mínimo de 6 caracteres")" />
                    <span asp-validation-for="Senha" class="erro-campo"></span>
                </div>
            </div>

            @{ ViewData["Rotulo"] = "Foto do colaborador"; }
            <partial name="_CampoImagem" model="Model" view-data="ViewData" />

            <div class="mt-4">
                <button type="submit" class="btn btn-primary">Salvar</button>
                <a class="btn btn-link" asp-action="Index">Voltar</a>
            </div>
        </form>
    </div>
</div>
