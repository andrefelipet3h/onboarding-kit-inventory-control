@model List<Colaborador>
@{
    ViewData["Title"] = "Colaboradores";
}
<div class="page-head">
    <h1>Colaboradores</h1>
    <a class="btn btn-primary" asp-action="Create">Novo colaborador</a>
</div>

<div class="cartao">
    <div class="tabela-rolavel">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Código</th>
                    <th>Foto</th>
                    <th>Nome</th>
                    <th>Funcional</th>
                    <th>Departamento</th>
                    <th>E-mail</th>
                    <th>Admissão</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td><strong>@c.Id</strong></td>
                        <td><img class="foto-mini" alt="" src="@(string.IsNullOrEmpty(c.ImagemEmBase64) ? Url.Content("~/img/sem-foto.svg") : "data:image/jpeg;base64," + c.ImagemEmBase64)" /></td>
                        <td>@c.Nome</td>
                        <td>@c.Funcional</td>
                        <td>@c.DepartamentoId - @c.NomeDepartamento</td>
                        <td>@c.Email</td>
                        <td class="nowrap">@c.DataAdmissao.ToString("dd/MM/yyyy")</td>
                        <td class="acoes-linha">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@c.Id" title="Editar"><i class="bi bi-pencil"></i></a>
                            <partial name="_BotaoExcluir" model="c.Id" />
                        </td>
                    </tr>
                }
                @if (Model.Count == 0)
                {
                    <tr><td colspan="8" class="vazio">Nenhum colaborador cadastrado.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
