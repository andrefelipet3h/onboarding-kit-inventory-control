@model List<Produto>
@{
    ViewData["Title"] = "Produtos";
}
<div class="page-head">
    <h1>Produtos</h1>
    <a class="btn btn-primary" asp-action="Create">Novo produto</a>
</div>

<p class="dica">A quantidade aumenta pela entrada na <a asp-controller="Home" asp-action="Index">tela principal</a> e diminui pela montagem dos kits.</p>

<div class="cartao">
    <div class="tabela-rolavel">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Código</th>
                    <th>Foto</th>
                    <th>Produto</th>
                    <th>Categoria</th>
                    <th class="text-end">Em estoque</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td><strong>@p.Id</strong></td>
                        <td><img class="foto-mini" alt="" src="@(string.IsNullOrEmpty(p.ImagemEmBase64) ? Url.Content("~/img/sem-foto.svg") : "data:image/jpeg;base64," + p.ImagemEmBase64)" /></td>
                        <td>@p.Nome<div class="dica">@p.Descricao</div></td>
                        <td>@p.Categoria</td>
                        <td class="text-end">@p.Estoque.Quantidade</td>
                        <td class="acoes-linha">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@p.Id" title="Editar"><i class="bi bi-pencil"></i></a>
                            <partial name="_BotaoExcluir" model="p.Id" />
                        </td>
                    </tr>
                }
                @if (Model.Count == 0)
                {
                    <tr><td colspan="6" class="vazio">Nenhum produto cadastrado.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
